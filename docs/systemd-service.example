[Unit]
Description=Telegram Droid CLI Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/path/to/telegram-droid-bot
EnvironmentFile=/etc/telegram-droid-bot.env

ExecStart=/usr/bin/node /path/to/telegram-droid-bot/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
